# Copy this file to ".env" and fill in your own Supabase project values.
# Find them in Supabase: Project Settings -> API.
# The publishable/anon key is safe for the browser (protected by Row-Level Security).
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
